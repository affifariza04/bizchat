# Salin file ini jadi ".env" lalu isi API key kamu.
# Tanpa API key, BizChat tetap jalan pakai knowledge base saja
# (pertanyaan yang tidak cocok otomatis dianggap "eskalasi ke staf").

# API key GRATIS dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port server (opsional, default 3000)
PORT=3000
